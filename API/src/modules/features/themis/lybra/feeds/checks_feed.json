      "mode": "safe",
      "requests": [
        {
          "method": "GET",
          "path": "/wp-config.php",
          "matchers-condition": "and",
          "matchers": [
            { "type": "status", "value": [200] },
            { "type": "word", "part": "body", "words": ["DB_PASSWORD", "DB_NAME"] }
          ]
