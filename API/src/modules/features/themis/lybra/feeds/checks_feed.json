{
  "feedVersion": "lybra-checks-4",
  "checks": [
    {
      "id": "git-config-exposure",
      "version": 1,
      "type": "http",
      "category": "exposed_path",
      "severity": "HIGH",
      "service": "http",
      "mode": "safe",
      "requests": [
        {
          "method": "GET",
          "path": "/.git/config",
          "matchers-condition": "and",
          "matchers": [
            { "type": "status", "value": [200] },
            { "type": "word", "part": "body", "words": ["[core]", "repositoryformatversion"] }
          ]
        }
      ],
      "finding": {
        "title": "Repositorio Git expuesto (.git/config accesible)",
        "qod": 99,
        "confirmed": true
      }
    },
    {
      "id": "dotenv-exposure",
      "version": 1,
      "type": "http",
      "category": "exposed_path",
      "severity": "HIGH",
      "service": "http",
      "mode": "safe",
      "requests": [
        {
          "method": "GET",
          "path": "/.env",
          "matchers-condition": "and",
          "matchers": [
            { "type": "status", "value": [200] },
            { "type": "regex", "part": "body", "regex": ["(?m)^[A-Z][A-Z0-9_]*="] }
          ]
        }
      ],
      "finding": {
        "title": "Fichero .env expuesto (posibles secretos accesibles)",
        "qod": 99,
        "confirmed": true
      }
    },
    {
      "id": "phpinfo-exposure",
      "version": 1,
      "type": "http",
