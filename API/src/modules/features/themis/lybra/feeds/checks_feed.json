      "mode": "safe",
      "requests": [
        {
          "method": "GET",
          "path": "/phpinfo.php",
          "matchers-condition": "and",
          "matchers": [
            { "type": "status", "value": [200] },
            { "type": "word", "part": "body", "words": ["phpinfo()", "PHP Version"] }
          ]
        }
      ],
      "finding": {
        "title": "phpinfo() expuesto (revela configuración interna del servidor)",
        "qod": 99,
        "confirmed": true
      }
    },
    {
