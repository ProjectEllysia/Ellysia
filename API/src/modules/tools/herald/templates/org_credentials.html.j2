{# Alta de una cuenta creada AL INVITAR a alguien que todavía no tenía una.
   Lleva credenciales, así que es el único correo del producto que las incluye.
   Contexto: organization_name, username, password, login_url. #}
{% extends "base.html.j2" %}
{% from "_macros.html.j2" import button, data_row %}

{% block title %}Tu cuenta en {{ brand.productName }}{% endblock %}

{% block preheader %}{{ organization_name }} te ha dado de alta en {{ brand.productName }}.{% endblock %}

{% block header_tagline %}
<div style="margin-top:8px; font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8a857c;">
  Alta de cuenta
</div>
{% endblock %}

{% block content %}
<p style="margin:0 0 16px;">Hola,</p>

<p style="margin:0 0 20px;">
  <strong>{{ organization_name }}</strong> te ha dado de alta en
  {{ brand.productName }}. Estas son tus credenciales de acceso:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="margin:0 0 20px; background-color:#faf8f5; border-left:3px solid {{ brand.accentColor }}; border-radius:0 6px 6px 0;">
  <tr>
    <td style="padding:16px 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        {{ data_row("Usuario", username) }}
        {{ data_row("Contraseña", password) }}
      </table>
    </td>
  </tr>
</table>

<p style="margin:0 0 20px; font-size:14px; color:#6b665e;">
  <strong>Cámbiala en cuanto entres.</strong> Esta contraseña la ha generado el
  sistema y ha viajado por correo, así que no sirve como secreto a largo plazo.
</p>

{{ button(login_url, "Entrar y cambiarla", brand.accentColor) }}

<p style="margin:20px 0 0; font-size:14px; color:#6b665e;">
  Tus datos en {{ brand.productName }} son tuyos: quien gestiona la organización
  no ve tus bóvedas, ni tus correos analizados, ni tus escaneos.
</p>
{% endblock %}
