{# Recuperación de contraseña por magic link.
   Contexto: recipient_name (opcional), reset_url, ttl_minutes. #}
{% extends "base.html.j2" %}
{% from "_macros.html.j2" import button %}

{% block title %}Recupera tu clave{% endblock %}

{% block preheader %}Restablece tu clave de acceso a {{ brand.productName }}.{% endblock %}

{% block header_tagline %}
<div style="margin-top:8px; font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8a857c;">
  Recuperación de contraseña
</div>
{% endblock %}

{% block content %}
<p style="margin:0 0 16px;">{% if recipient_name %}Hola {{ recipient_name }},{% else %}Hola,{% endif %}</p>

<p style="margin:0 0 20px;">
  Hemos recibido una solicitud para restablecer la clave de acceso de tu cuenta
  de {{ brand.productName }}. Pulsa el botón para elegir una nueva:
</p>

{{ button(reset_url, "Restablecer mi clave", brand.accentColor) }}

<p style="margin:20px 0 0; font-size:14px; color:#6b665e;">
  El enlace caduca en {{ ttl_minutes }} minutos. Si caduca, puedes pedir uno nuevo
  desde la pantalla de acceso.
</p>

<p style="margin:16px 0 0; font-size:14px; color:#6b665e;">
  Si no has sido tú quien ha pedido este enlace, ignora este mensaje: tu clave
  seguirá siendo la misma.
</p>
{% endblock %}
