{#
  Envoltura común de los correos de Ellysia.

  HTML de correo, no HTML de web: tablas en vez de flex/grid, estilos inline
  en vez de hojas o clases, y anchura fija de 600 px. Outlook renderiza con el
  motor de Word y Gmail elimina <style> en muchos clientes — cualquier cosa
  más moderna se cae en la mitad de las bandejas.

  Bloques que rellenan las plantillas hijas:
    preheader   texto de vista previa (lo que se ve junto al asunto)
    content     cuerpo del correo
    footer      pie, si hace falta cambiar el de por defecto
#}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{% block title %}{{ brand.productName }}{% endblock %}</title>
</head>
<body style="margin:0; padding:0; background-color:#f2f0ec; -webkit-font-smoothing:antialiased;">

{# Vista previa de la bandeja: se lee en la lista de correos, no en el cuerpo. #}
<div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">
  {% block preheader %}{% endblock %}
  {# Relleno para que el cliente no arrastre el principio del cuerpo al preview. #}
  &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color:#f2f0ec;">
  <tr>
    <td align="center" style="padding:32px 12px;">

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
             style="width:600px; max-width:100%; background-color:#ffffff; border:1px solid #e2ddd4; border-radius:10px; overflow:hidden;">

        {# ── Cabecera de marca ── #}
        <tr>
          <td align="center" style="background-color:#16151a; padding:24px 32px;">
            {% if brand.logoUrl %}
            <img src="{{ brand.logoUrl }}" alt="{{ brand.productName }}" width="150"
                 style="display:block; border:0; max-width:150px; height:auto;">
            {% else %}
            <div style="font-family:Georgia,'Times New Roman',serif; font-size:24px; font-weight:normal; letter-spacing:0.18em; text-transform:uppercase; color:{{ brand.accentColor }};">
              {{ brand.productName }}
            </div>
            {% endif %}
            {% block header_tagline %}{% endblock %}
          </td>
        </tr>

        {# ── Filete de acento ── #}
        <tr><td style="height:3px; line-height:3px; font-size:0; background-color:{{ brand.accentColor }};">&nbsp;</td></tr>

        {# ── Cuerpo ── #}
        <tr>
          <td style="padding:32px; font-family:Helvetica,Arial,sans-serif; font-size:16px; line-height:1.6; color:#2c2a26;">
            {% block content %}{% endblock %}
          </td>
        </tr>

        {# ── Pie ── #}
        <tr>
          <td style="background-color:#faf8f5; border-top:1px solid #e2ddd4; padding:20px 32px; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.5; color:#8a857c;">
            {% block footer %}
            <p style="margin:0 0 6px;">Este mensaje se ha enviado automáticamente desde {{ brand.productName }}. No respondas a esta dirección.</p>
            {% if brand.supportEmail %}
            <p style="margin:0 0 6px;">¿Dudas? Escribe a <a href="mailto:{{ brand.supportEmail }}" style="color:#8a857c;">{{ brand.supportEmail }}</a>.</p>
            {% endif %}
            {% if brand.footerNote %}
            <p style="margin:0;">{{ brand.footerNote }}</p>
            {% endif %}
            {% endblock %}
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>

</body>
</html>
