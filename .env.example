# ──────────────────────────────────────────────────────────────────────────────
# .env.example  —  Variables de entorno para docker-compose
# ──────────────────────────────────────────────────────────────────────────────


# ── APP CONTEXT ────────────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT=30
CREATE_DATABASE=False
DEBUG=False
HOST=0.0.0.0
PORT=5000

# ── JWT ────────────────────────────────────────────────────────────────
# Solo el secreto vive en .env. El algoritmo y los tiempos de expiración
# se configuran en API/SecOpsConfig.json (security.jwt) y pueden
# sobreescribirse aquí con JWT_ALGORITHM, ACCESS_TOKEN_EXPIRY_MINUTES y
# REFRESH_TOKEN_EXPIRY_DAYS si el entorno lo requiere (12-factor).
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars_required

# ── MFA (TOTP Encryption) ──────────────────────────────────────────────
# Clave Fernet (32 bytes urlsafe-base64) para cifrar los secretos TOTP en
# reposo. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# O manualmente (openssl):
#   openssl rand -base64 32 | tr '+/' '-_'
MFA_ENCRYPTION_KEY=your_fernet_key_here_32_bytes_urlsafe_base64

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=your_database_name
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
POSTGRES_DIALECT=postgresql+psycopg2

# ── Ollama ────────────────────────────────────────────────────────────────────
# El host sí vive aquí (es infraestructura del despliegue). El MODELO ya no
# hace falta tocarlo aquí: se elige desde el panel de configuración
# (tools.scribe.strategies.ollama.model), que gana a esta variable y se aplica
# al siguiente trabajo en segundo plano sin reiniciar nada. Esta se sigue
# usando cuando el campo del panel se deja vacío.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# ── SMTP (herald) ─────────────────────────────────────────────────────────────
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# ── Public Web URL (for email links) ──────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:5173

# ── OpenAI ──────────────────────────────────────────────────────────────────────
# Solo la credencial es obligatoria aquí. El modelo se elige desde el panel
# (tools.scribe.strategies.openai.model); OPENAI_MODEL es el fallback para
# cuando ese campo se deja vacío.
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini        # opcional, fallback si el panel no fija modelo
# Apunta a un proveedor compatible con la API de OpenAI (vLLM, LM Studio, un
# gateway propio). Vacío = api.openai.com.
OPENAI_BASE_URL=

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash   # opcional, fallback si el panel no fija modelo

# ── Iris mailbox connector (Gmail / Microsoft Graph) ───────────────────────────
# Clave Fernet para cifrar en reposo el refresh token OAuth de cada buzón
# conectado. Misma generación que MFA_ENCRYPTION_KEY, clave DISTINTA (no
# reutilizar la de MFA) — cada purpose de shared/_crypto.py rota por separado.
IRIS_MAILBOX_ENCRYPTION_KEY=your_fernet_key_here_32_bytes_urlsafe_base64

# Clave Fernet para cifrar en reposo el contenido raw (cabeceras o .eml
# completo) de cada análisis de Iris, que vive en su propia fila
# (IrisRawMessage) para poder purgarse por retención sin borrar el resultado.
# Otra clave DISTINTA de las dos anteriores, por el mismo motivo.
#
# A diferencia de las credenciales OAuth de abajo, esta NO es opcional: la
# escribe cualquier análisis, también el de un correo pegado a mano, así que
# sin ella Iris no funciona. Y falla tarde — get_encryption_key la resuelve de
# forma perezosa, de modo que la API arranca sin quejarse y revienta en el
# primer análisis.
IRIS_RAW_MESSAGE_ENCRYPTION_KEY=your_fernet_key_here_32_bytes_urlsafe_base64

# App OAuth de Google Cloud Console (tipo "Web application"), con el scope
# gmail.metadata o gmail.readonly habilitado y esta redirect URI autorizada:
#   <PUBLIC_WEB_URL o backend>/iris/mailbox/callback
# Opcional: si faltan, POST /iris/mailbox/connect con provider=gmail devuelve
# un error claro; el resto de la API funciona igual.
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here

# App registration de Microsoft Entra ID (Azure AD), con el permiso delegado
# Mail.Read y la misma redirect URI que arriba autorizada. GRAPH_TENANT_ID
# es opcional ("common" = cuentas personales + de organización cualquiera).
GRAPH_CLIENT_ID=your_graph_oauth_client_id_here
GRAPH_CLIENT_SECRET=your_graph_oauth_client_secret_here
GRAPH_TENANT_ID=common
